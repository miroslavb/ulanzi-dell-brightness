{
  "Author": "Miroslav Babitski",
  "Name": "Dell Monitor Brightness",
  "Description": "Adjust any DDC/CI monitor from Ulanzi keys or a D200X encoder, with selectable MDI icons.",
  "Icon": "assets/icons/pluginIcon.png",
  "Version": "1.1.0",
  "Category": "Monitor Brightness",
  "CategoryIcon": "assets/icons/categoryIcon.png",
  "CodePath": "plugin/app.js",
  "Type": "JavaScript",
  "Inspect": "--inspect=127.0.0.1:9233",
  "PrivateAPI": true,
  "UUID": "com.ulanzi.ulanzistudio.dellbrightness",
  "Actions": [
    {
      "Name": "Brighter",
      "Icon": "assets/icons/brighter.png",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "state": 0,
      "States": [
        { "Name": "Brighter", "Image": "assets/icons/brighter.png" }
      ],
      "Tooltip": "Increase monitor brightness",
      "UUID": "com.ulanzi.ulanzistudio.dellbrightness.brighter",
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "Controllers": ["Keypad"],
      "Devices": []
    },
    {
      "Name": "Darker",
      "Icon": "assets/icons/darker.png",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "state": 0,
      "States": [
        { "Name": "Darker", "Image": "assets/icons/darker.png" }
      ],
      "Tooltip": "Decrease monitor brightness",
      "UUID": "com.ulanzi.ulanzistudio.dellbrightness.darker",
      "SupportedInMultiActions": true,
      "DisableAutomaticStates": true,
      "Controllers": ["Keypad"],
      "Devices": []
    },
    {
      "Name": "Brightness Encoder",
      "Icon": "assets/icons/brighter.png",
      "PropertyInspectorPath": "property-inspector/inspector.html",
      "state": 0,
      "States": [
        { "Name": "Brightness", "Image": "assets/icons/brighter.png" }
      ],
      "Tooltip": "Turn to adjust monitor brightness",
      "UUID": "com.ulanzi.ulanzistudio.dellbrightness.encoder",
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "Controllers": ["Encoder"],
      "Devices": ["D200X", "Dial"],
      "Encoder": { "layout": "$UA1" }
    }
  ],
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Software": {
    "MinVersion": "2.1.4"
  }
}
